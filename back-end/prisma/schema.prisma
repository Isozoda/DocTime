generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums — stored as String
// Valid role values: "patient" | "doctor" | "admin"
// Valid status values: "pending" | "confirmed" | "cancelled"

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("patient")
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor       Doctor?
  appointments Appointment[] @relation("PatientAppointments")
  feedbacks    Feedback[]
}

model Doctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  specialization String
  city           String
  rating         Float    @default(0)
  experience     Int      @default(0)
  bio            String?
  schedule       String?
  instagram      String?
  phone          String?
  photoUrl       String?
  address        String?
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments      Appointment[]     @relation("DoctorAppointments")
  hospitals         HospitalDoctor[]
  serviceCategories ServiceCategory[]
  services          Service[]
}

model Appointment {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  date      DateTime
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User   @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
}

model Specialization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospitals HospitalSpecialization[]
}

model Hospital {
  id           String   @id @default(uuid())
  name         String
  address      String
  city         String
  phone        String?
  instagram    String?
  googleMapUrl String?
  imageUrl     String?
  rating       Float    @default(0)
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  specializations HospitalSpecialization[]
  doctors         HospitalDoctor[]
}

model HospitalSpecialization {
  hospitalId       String
  specializationId String

  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([hospitalId, specializationId])
}

model HospitalDoctor {
  hospitalId String
  doctorId   String

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([hospitalId, doctorId])
}

model OtpRequest {
  id        String   @id @default(uuid())
  phone     String   @unique
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ServiceCategory {
  id       String    @id @default(uuid())
  doctorId String
  name     String
  createdAt DateTime @default(now())

  doctor   Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  services Service[]
}

model Service {
  id         String           @id @default(uuid())
  doctorId   String
  categoryId String?
  name       String
  price      Float            @default(0)
  duration   Int              @default(30)
  isHidden   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  doctor   Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
